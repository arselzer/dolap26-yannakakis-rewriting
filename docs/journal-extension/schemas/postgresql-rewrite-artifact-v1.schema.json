{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yannakakis-rewriting.invalid/schemas/postgresql-rewrite-artifact-v1.schema.json",
  "title": "Yannakakis PostgreSQL rewrite artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "exit_code", "request", "outcome", "report"],
  "properties": {
    "schema_version": {"const": "yannakakis-postgresql-rewrite/v1"},
    "status": {
      "enum": [
        "rewritten", "not_applicable", "invalid_query", "failed",
        "invalid_invocation", "input_error", "service_unavailable", "internal_error"
      ]
    },
    "exit_code": {"enum": [0, 2, 3, 4, 64, 66, 69, 70]},
    "request": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/request"}]},
    "outcome": {"$ref": "#/$defs/outcome"},
    "report": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/report"}]}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "positive": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidateId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_dialect", "options", "original_sql", "original_sql_sha256"],
      "properties": {
        "target_dialect": {"const": "postgresql"},
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width_bound", "plan_limit", "require_connected_cover"],
          "properties": {
            "width_bound": {"$ref": "#/$defs/positive"},
            "plan_limit": {"$ref": "#/$defs/positive"},
            "require_connected_cover": {"type": "boolean"}
          }
        },
        "original_sql": {"type": "string"},
        "original_sql_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rewritten_statements", "rewritten_statement_sha256", "diagnostics"],
      "properties": {
        "rewritten_statements": {"type": "array", "items": {"type": "string"}},
        "rewritten_statement_sha256": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "context"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string", "minLength": 1},
        "context": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_phase", "analysis", "hypergraph", "soft_generation",
        "admissible_generation", "candidate_input", "candidate_search",
        "selected_plan", "bag_factor_plan", "rendering"
      ],
      "properties": {
        "completed_phase": {
          "enum": [
            "request-accepted", "sql-planned", "query-analyzed", "hypergraph-built",
            "soft-bags-generated", "candidate-input-built", "candidate-search-completed",
            "bag-factor-planned", "rendered"
          ]
        },
        "analysis": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/analysis"}]},
        "hypergraph": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hypergraph"}]},
        "soft_generation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/softGeneration"}]},
        "admissible_generation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/admissibleGeneration"}]},
        "candidate_input": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/candidateInput"}]},
        "candidate_search": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/candidateSearch"}]},
        "selected_plan": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/selectedPlan"}]},
        "bag_factor_plan": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/bagFactorPlan"}]},
        "rendering": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/rendering"}]}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "relation_count", "predicate_count", "output_column_count", "diagnostic_count"],
      "properties": {
        "supported": {"type": "boolean"},
        "relation_count": {"$ref": "#/$defs/count"},
        "predicate_count": {"$ref": "#/$defs/count"},
        "output_column_count": {"$ref": "#/$defs/count"},
        "diagnostic_count": {"$ref": "#/$defs/count"}
      }
    },
    "hypergraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_count", "variable_count", "column_count"],
      "properties": {
        "edge_count": {"$ref": "#/$defs/count"},
        "variable_count": {"$ref": "#/$defs/count"},
        "column_count": {"$ref": "#/$defs/count"}
      }
    },
    "softGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_bound", "enumerated_cover_count", "candidate_count", "witness_count",
        "physical_cover_count", "connected_physical_cover_count"
      ],
      "properties": {
        "width_bound": {"$ref": "#/$defs/positive"},
        "enumerated_cover_count": {"$ref": "#/$defs/count"},
        "candidate_count": {"$ref": "#/$defs/count"},
        "witness_count": {"$ref": "#/$defs/count"},
        "physical_cover_count": {"$ref": "#/$defs/count"},
        "connected_physical_cover_count": {"$ref": "#/$defs/count"}
      }
    },
    "admissibleGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_bound", "require_connected_cover", "definition_cover_count",
        "candidate_count", "witness_count", "physical_cover_count",
        "connected_physical_cover_count"
      ],
      "properties": {
        "width_bound": {"$ref": "#/$defs/positive"},
        "require_connected_cover": {"type": "boolean"},
        "definition_cover_count": {"$ref": "#/$defs/count"},
        "candidate_count": {"$ref": "#/$defs/count"},
        "witness_count": {"$ref": "#/$defs/count"},
        "physical_cover_count": {"$ref": "#/$defs/count"},
        "connected_physical_cover_count": {"$ref": "#/$defs/count"}
      }
    },
    "candidateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_bound", "require_connected_cover", "candidate_bag_count"],
      "properties": {
        "width_bound": {"$ref": "#/$defs/positive"},
        "require_connected_cover": {"type": "boolean"},
        "candidate_bag_count": {"$ref": "#/$defs/count"}
      }
    },
    "candidateSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "requested_limit", "returned_plan_count", "statistics", "plans"],
      "properties": {
        "decision": {"enum": ["found", "rejected"]},
        "requested_limit": {"$ref": "#/$defs/positive"},
        "returned_plan_count": {"$ref": "#/$defs/count"},
        "statistics": {"$ref": "#/$defs/candidateStatistics"},
        "plans": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/candidatePlan"}}
      }
    },
    "candidateStatistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_bag_count", "block_count", "basis_alternative_count",
        "satisfied_block_count", "retained_partial_plan_count", "combination_state_count"
      ],
      "properties": {
        "candidate_bag_count": {"$ref": "#/$defs/count"},
        "block_count": {"$ref": "#/$defs/count"},
        "basis_alternative_count": {"$ref": "#/$defs/count"},
        "satisfied_block_count": {"$ref": "#/$defs/count"},
        "retained_partial_plan_count": {"$ref": "#/$defs/count"},
        "combination_state_count": {"$ref": "#/$defs/count"}
      }
    },
    "candidatePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "candidate_id", "structural_score", "cover_selection_policy", "certificate", "decomposition"],
      "properties": {
        "rank": {"$ref": "#/$defs/positive"},
        "candidate_id": {"$ref": "#/$defs/candidateId"},
        "structural_score": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_count"],
          "properties": {"node_count": {"$ref": "#/$defs/positive"}}
        },
        "cover_selection_policy": {"const": "first_canonical_admissible_cover_v1"},
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bag_count", "component_arc_count", "require_connected_cover"],
          "properties": {
            "bag_count": {"$ref": "#/$defs/positive"},
            "component_arc_count": {"$ref": "#/$defs/count"},
            "require_connected_cover": {"type": "boolean"}
          }
        },
        "decomposition": {"$ref": "#/$defs/decomposition"}
      }
    },
    "selectedPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_policy", "cost_selected", "rank", "candidate_id", "decomposition"],
      "properties": {
        "selection_policy": {"const": "structural_top_k_head_v1"},
        "cost_selected": {"const": false},
        "rank": {"const": 1},
        "candidate_id": {"$ref": "#/$defs/candidateId"},
        "decomposition": {"$ref": "#/$defs/decomposition"}
      }
    },
    "decomposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_bag_id", "width", "bags", "tree_edges"],
      "properties": {
        "root_bag_id": {"$ref": "#/$defs/count"},
        "width": {"$ref": "#/$defs/count"},
        "bags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "vertices", "cover_edge_ids"],
            "properties": {
              "id": {"$ref": "#/$defs/count"},
              "vertices": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/count"}},
              "cover_edge_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/count"}}
            }
          }
        },
        "tree_edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["first", "second"],
            "properties": {
              "first": {"$ref": "#/$defs/count"},
              "second": {"$ref": "#/$defs/count"}
            }
          }
        }
      }
    },
    "bagFactorPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_bag_id", "width_bound", "require_connected_cover", "factor_count",
        "ownership_count", "arc_count", "bottom_up_step_count", "top_down_step_count"
      ],
      "properties": {
        "root_bag_id": {"$ref": "#/$defs/count"},
        "width_bound": {"$ref": "#/$defs/positive"},
        "require_connected_cover": {"type": "boolean"},
        "factor_count": {"$ref": "#/$defs/positive"},
        "ownership_count": {"$ref": "#/$defs/count"},
        "arc_count": {"$ref": "#/$defs/count"},
        "bottom_up_step_count": {"$ref": "#/$defs/count"},
        "top_down_step_count": {"$ref": "#/$defs/count"}
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_column_count", "expanded_scan_count", "rendered_term_count", "cte_count", "sql_character_count"],
      "properties": {
        "output_column_count": {"$ref": "#/$defs/count"},
        "expanded_scan_count": {"$ref": "#/$defs/count"},
        "rendered_term_count": {"$ref": "#/$defs/count"},
        "cte_count": {"$ref": "#/$defs/count"},
        "sql_character_count": {"$ref": "#/$defs/count"}
      }
    }
  }
}
