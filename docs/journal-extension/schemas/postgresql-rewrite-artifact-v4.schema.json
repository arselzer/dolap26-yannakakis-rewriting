{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yannakakis-rewriting.invalid/schemas/postgresql-rewrite-artifact-v4.schema.json",
  "title": "Yannakakis PostgreSQL rewrite artifact v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "exit_code",
    "request",
    "outcome",
    "report"
  ],
  "properties": {
    "schema_version": {
      "const": "yannakakis-postgresql-rewrite/v4"
    },
    "status": {
      "enum": [
        "rewritten",
        "not_applicable",
        "invalid_query",
        "failed",
        "invalid_invocation",
        "input_error",
        "service_unavailable",
        "internal_error"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        2,
        3,
        4,
        64,
        66,
        69,
        70
      ]
    },
    "request": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/request"
        }
      ]
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "report": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/report"
        }
      ]
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "positive": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidateIdScheme": {
      "const": "covered_decomposition_json_v1"
    },
    "selectionPolicy": {
      "enum": [
        "structural_top_k_head_v1",
        "explicit_structural_rank_v1",
        "explicit_candidate_id_v1",
        "postgresql_static_shape_lexicographic_v1",
        "postgresql_explain_row_guarded_total_cost_v1"
      ]
    },
    "selectionScope": {
      "const": "retained_structural_top_k_first_canonical_cover_v1"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_dialect",
        "options",
        "original_sql",
        "original_sql_sha256"
      ],
      "properties": {
        "target_dialect": {
          "const": "postgresql"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width_bound",
            "plan_limit",
            "require_connected_cover",
            "candidate_selection",
            "reduction_schedule"
          ],
          "properties": {
            "width_bound": {
              "$ref": "#/$defs/positive"
            },
            "plan_limit": {
              "$ref": "#/$defs/positive"
            },
            "require_connected_cover": {
              "type": "boolean"
            },
            "candidate_selection": {
              "$ref": "#/$defs/requestedSelection"
            },
            "reduction_schedule": {
              "$ref": "#/$defs/reductionMode"
            }
          }
        },
        "original_sql": {
          "type": "string"
        },
        "original_sql_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "requestedSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "requested_rank",
        "requested_candidate_id"
      ],
      "properties": {
        "policy": {
          "$ref": "#/$defs/selectionPolicy"
        },
        "requested_rank": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/positive"
            }
          ]
        },
        "requested_candidate_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/candidateId"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "policy": {
              "const": "structural_top_k_head_v1"
            },
            "requested_rank": {
              "type": "null"
            },
            "requested_candidate_id": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "policy": {
              "const": "explicit_structural_rank_v1"
            },
            "requested_rank": {
              "$ref": "#/$defs/positive"
            },
            "requested_candidate_id": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "policy": {
              "const": "explicit_candidate_id_v1"
            },
            "requested_rank": {
              "type": "null"
            },
            "requested_candidate_id": {
              "$ref": "#/$defs/candidateId"
            }
          }
        },
        {
          "properties": {
            "policy": {
              "const": "postgresql_static_shape_lexicographic_v1"
            },
            "requested_rank": {
              "type": "null"
            },
            "requested_candidate_id": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "policy": {
              "const": "postgresql_explain_row_guarded_total_cost_v1"
            },
            "requested_rank": {
              "type": "null"
            },
            "requested_candidate_id": {
              "type": "null"
            }
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rewritten_statements",
        "rewritten_statement_sha256",
        "diagnostics"
      ],
      "properties": {
        "rewritten_statements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rewritten_statement_sha256": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "context"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_phase",
        "analysis",
        "hypergraph",
        "soft_generation",
        "admissible_generation",
        "candidate_input",
        "candidate_search",
        "candidate_selection",
        "selected_plan",
        "bag_factor_plan",
        "rendering"
      ],
      "properties": {
        "completed_phase": {
          "enum": [
            "request-accepted",
            "sql-planned",
            "query-analyzed",
            "hypergraph-built",
            "soft-bags-generated",
            "candidate-input-built",
            "candidate-search-completed",
            "candidate-selection-completed",
            "bag-factor-planned",
            "rendered"
          ]
        },
        "analysis": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/analysis"
            }
          ]
        },
        "hypergraph": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/hypergraph"
            }
          ]
        },
        "soft_generation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/softGeneration"
            }
          ]
        },
        "admissible_generation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/admissibleGeneration"
            }
          ]
        },
        "candidate_input": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/candidateInput"
            }
          ]
        },
        "candidate_search": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/candidateSearch"
            }
          ]
        },
        "candidate_selection": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/candidateSelection"
            }
          ]
        },
        "selected_plan": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/selectedPlan"
            }
          ]
        },
        "bag_factor_plan": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bagFactorPlan"
            }
          ]
        },
        "rendering": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/rendering"
            }
          ]
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "relation_count",
        "predicate_count",
        "output_column_count",
        "diagnostic_count"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "relation_count": {
          "$ref": "#/$defs/count"
        },
        "predicate_count": {
          "$ref": "#/$defs/count"
        },
        "output_column_count": {
          "$ref": "#/$defs/count"
        },
        "diagnostic_count": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "hypergraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_count",
        "variable_count",
        "column_count"
      ],
      "properties": {
        "edge_count": {
          "$ref": "#/$defs/count"
        },
        "variable_count": {
          "$ref": "#/$defs/count"
        },
        "column_count": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "softGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_bound",
        "enumerated_cover_count",
        "candidate_count",
        "witness_count",
        "physical_cover_count",
        "connected_physical_cover_count"
      ],
      "properties": {
        "width_bound": {
          "$ref": "#/$defs/positive"
        },
        "enumerated_cover_count": {
          "$ref": "#/$defs/count"
        },
        "candidate_count": {
          "$ref": "#/$defs/count"
        },
        "witness_count": {
          "$ref": "#/$defs/count"
        },
        "physical_cover_count": {
          "$ref": "#/$defs/count"
        },
        "connected_physical_cover_count": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "admissibleGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_bound",
        "require_connected_cover",
        "definition_cover_count",
        "candidate_count",
        "witness_count",
        "physical_cover_count",
        "connected_physical_cover_count"
      ],
      "properties": {
        "width_bound": {
          "$ref": "#/$defs/positive"
        },
        "require_connected_cover": {
          "type": "boolean"
        },
        "definition_cover_count": {
          "$ref": "#/$defs/count"
        },
        "candidate_count": {
          "$ref": "#/$defs/count"
        },
        "witness_count": {
          "$ref": "#/$defs/count"
        },
        "physical_cover_count": {
          "$ref": "#/$defs/count"
        },
        "connected_physical_cover_count": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "candidateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_bound",
        "require_connected_cover",
        "candidate_bag_count"
      ],
      "properties": {
        "width_bound": {
          "$ref": "#/$defs/positive"
        },
        "require_connected_cover": {
          "type": "boolean"
        },
        "candidate_bag_count": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "candidateSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "candidate_id_scheme",
        "requested_limit",
        "returned_plan_count",
        "statistics",
        "plans"
      ],
      "properties": {
        "decision": {
          "enum": [
            "found",
            "rejected"
          ]
        },
        "candidate_id_scheme": {
          "$ref": "#/$defs/candidateIdScheme"
        },
        "requested_limit": {
          "$ref": "#/$defs/positive"
        },
        "returned_plan_count": {
          "$ref": "#/$defs/count"
        },
        "statistics": {
          "$ref": "#/$defs/candidateStatistics"
        },
        "plans": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/candidatePlan"
          }
        }
      }
    },
    "candidateStatistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_bag_count",
        "block_count",
        "basis_alternative_count",
        "satisfied_block_count",
        "retained_partial_plan_count",
        "combination_state_count"
      ],
      "properties": {
        "candidate_bag_count": {
          "$ref": "#/$defs/count"
        },
        "block_count": {
          "$ref": "#/$defs/count"
        },
        "basis_alternative_count": {
          "$ref": "#/$defs/count"
        },
        "satisfied_block_count": {
          "$ref": "#/$defs/count"
        },
        "retained_partial_plan_count": {
          "$ref": "#/$defs/count"
        },
        "combination_state_count": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "candidatePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "candidate_id",
        "structural_score",
        "cover_selection_policy",
        "certificate",
        "decomposition"
      ],
      "properties": {
        "rank": {
          "$ref": "#/$defs/positive"
        },
        "candidate_id": {
          "$ref": "#/$defs/candidateId"
        },
        "structural_score": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_count"
          ],
          "properties": {
            "node_count": {
              "$ref": "#/$defs/positive"
            }
          }
        },
        "cover_selection_policy": {
          "const": "first_canonical_admissible_cover_v1"
        },
        "certificate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bag_count",
            "component_arc_count",
            "require_connected_cover"
          ],
          "properties": {
            "bag_count": {
              "$ref": "#/$defs/positive"
            },
            "component_arc_count": {
              "$ref": "#/$defs/count"
            },
            "require_connected_cover": {
              "type": "boolean"
            }
          }
        },
        "decomposition": {
          "$ref": "#/$defs/decomposition"
        }
      }
    },
    "physicalShapeScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expanded_scan_count",
        "materialized_distinct_support_count",
        "cte_count",
        "rendered_term_count",
        "sql_character_count",
        "structural_rank"
      ],
      "properties": {
        "expanded_scan_count": {
          "$ref": "#/$defs/count"
        },
        "materialized_distinct_support_count": {
          "$ref": "#/$defs/count"
        },
        "cte_count": {
          "$ref": "#/$defs/count"
        },
        "rendered_term_count": {
          "$ref": "#/$defs/count"
        },
        "sql_character_count": {
          "$ref": "#/$defs/count"
        },
        "structural_rank": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "optimizerEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "metric",
        "units",
        "explain_format",
        "analyze",
        "settings",
        "estimated",
        "runtime_measured",
        "startup_cost",
        "plan_total_cost",
        "plan_rows",
        "plan_width"
      ],
      "properties": {
        "source": {
          "const": "postgresql_explain_format_json_analyze_false_v1"
        },
        "metric": {
          "const": "plan_total_cost"
        },
        "units": {
          "const": "postgresql_cost_units"
        },
        "explain_format": {
          "const": "json"
        },
        "analyze": {
          "const": false
        },
        "settings": {
          "const": true
        },
        "estimated": {
          "const": true
        },
        "runtime_measured": {
          "const": false
        },
        "startup_cost": {
          "type": "number",
          "minimum": 0
        },
        "plan_total_cost": {
          "type": "number",
          "minimum": 0
        },
        "plan_rows": {
          "type": "number",
          "minimum": 0
        },
        "plan_width": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "costProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_version_num",
        "planner_settings_fingerprint_sha256",
        "planner_settings_fingerprint_scheme",
        "planner_setting_count"
      ],
      "properties": {
        "server_version_num": {
          "$ref": "#/$defs/positive"
        },
        "planner_settings_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "planner_settings_fingerprint_scheme": {
          "const": "postgresql_planner_settings_utf8_length_prefixed_v1"
        },
        "planner_setting_count": {
          "const": 53
        }
      }
    },
    "sourceOptimizerEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_statement_sha256",
        "optimizer_estimate"
      ],
      "properties": {
        "source_statement_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "optimizer_estimate": {
          "$ref": "#/$defs/optimizerEstimate"
        }
      }
    },
    "rowGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factor",
        "ratio_numerator",
        "ratio_denominator",
        "within_guard"
      ],
      "properties": {
        "factor": {
          "const": 10
        },
        "ratio_numerator": {
          "type": "number",
          "minimum": 0
        },
        "ratio_denominator": {
          "type": "number",
          "minimum": 1
        },
        "within_guard": {
          "type": "boolean"
        }
      }
    },
    "candidateEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "candidate_id",
        "rendered_statement_sha256",
        "physical_shape_score",
        "physical_variant_id",
        "reduction_schedule",
        "reduction_order",
        "optimizer_estimate",
        "row_guard"
      ],
      "properties": {
        "rank": {
          "$ref": "#/$defs/positive"
        },
        "candidate_id": {
          "$ref": "#/$defs/candidateId"
        },
        "rendered_statement_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "physical_shape_score": {
          "$ref": "#/$defs/physicalShapeScore"
        },
        "physical_variant_id": {
          "$ref": "#/$defs/physicalVariantId"
        },
        "reduction_schedule": {
          "$ref": "#/$defs/reductionMode"
        },
        "reduction_order": {
          "$ref": "#/$defs/reductionOrder"
        },
        "optimizer_estimate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/optimizerEstimate"
            }
          ]
        },
        "row_guard": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/rowGuard"
            }
          ]
        }
      }
    },
    "candidateSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "policy",
        "selection_scope",
        "cost_selected",
        "estimated_cost_selected",
        "measured_runtime_selected",
        "uses_catalog_statistics",
        "uses_execution_feedback",
        "score_order",
        "cost_order",
        "cost_provenance",
        "source_optimizer_estimate",
        "explain_failure_stage",
        "evaluated_candidate_count",
        "evaluations",
        "selected_rank",
        "selected_candidate_id",
        "failed_rank",
        "failed_candidate_id",
        "retained_candidate_count",
        "physical_variant_id_scheme",
        "reduction_schedule",
        "reduction_order",
        "selected_physical_variant_id",
        "failed_physical_variant_id"
      ],
      "properties": {
        "decision": {
          "enum": [
            "selected",
            "unavailable",
            "evaluation_failed",
            "explain_evaluation_failed",
            "no_admissible_estimate"
          ]
        },
        "policy": {
          "$ref": "#/$defs/selectionPolicy"
        },
        "selection_scope": {
          "$ref": "#/$defs/selectionScope"
        },
        "cost_selected": {
          "type": "boolean"
        },
        "estimated_cost_selected": {
          "type": "boolean"
        },
        "measured_runtime_selected": {
          "const": false
        },
        "uses_catalog_statistics": {
          "type": "boolean"
        },
        "uses_execution_feedback": {
          "const": false
        },
        "score_order": {
          "const": [
            "expanded_scan_count",
            "materialized_distinct_support_count",
            "cte_count",
            "rendered_term_count",
            "sql_character_count",
            "structural_rank"
          ]
        },
        "cost_order": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "const": [
                "plan_total_cost",
                "structural_rank",
                "candidate_id"
              ]
            }
          ]
        },
        "cost_provenance": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/costProvenance"
            }
          ]
        },
        "source_optimizer_estimate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sourceOptimizerEstimate"
            }
          ]
        },
        "explain_failure_stage": {
          "oneOf": [
            {
